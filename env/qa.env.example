# Names and placeholders only (Annex J.5.1). Copy to env/qa.env, which is git-ignored, and fill it in.
# qa: the real values come from the secret of the environment, never from this repository. The management UI is
# not published here: operate the broker with rabbitmqctl inside the container.
COMPOSE_PROJECT_NAME=csp-qa

# Operation and health check of the instance; no service uses it.
RABBIT_ADMIN_PASSWORD=
# Passwords of the service logins. They go inside the AMQP URLs below, so they must be URL-safe: openssl rand -hex 24
# worker_relay: may only publish to the exchange cine.events (csp-worker).
WORKER_RELAY_PASSWORD=
# ticketing_fulfillment and concessions: configure and read only their own queues cine.<login>.*
TICKETING_FULFILLMENT_PASSWORD=
CONCESSIONS_PASSWORD=

# What the services read. The broker is reached by its service name on the platform network, never by localhost.
RELAY_AMQP_URL=amqp://worker_relay:${WORKER_RELAY_PASSWORD}@rabbitmq:5672/%2F
TICKETING_AMQP_URL=amqp://ticketing_fulfillment:${TICKETING_FULFILLMENT_PASSWORD}@rabbitmq:5672/%2F
CONCESSIONS_AMQP_URL=amqp://concessions:${CONCESSIONS_PASSWORD}@rabbitmq:5672/%2F
